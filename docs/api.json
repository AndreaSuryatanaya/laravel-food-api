                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create Product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/products",
              "host": [
                "http://localhost:8000"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Hanya admin (middleware role.admin).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"name\": \"Nasi Goreng\",\n  \"description\": \"Nasi goreng spesial\",\n  \"price\": 25000,\n  \"stock\": 50,\n  \"image_url\": \"https://example.com/nasi-goreng.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.id) pm.collectionVariables.set('productId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product - PUT (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/products/{{productId}}",
              "host": [
                "http://localhost:8000"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"name\": \"Nasi Goreng Special\",\n  \"description\": \"Update\",\n  \"price\": 30000,\n  \"stock\": 40,\n  \"image_url\": null\n}",
              "options": {
                "raw": {
